<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>10</LangVersion> 
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FsLexYacc.Runtime" Version="11.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Lang.fs" />
    <Compile Include="Parsing/Parse.fs" />
    <Compile Include="Parsing/Lex.fs" />
    <Compile Include="State.fs" />
    <Compile Include="Monad.fs" />
    <Compile Include="Normalization.fs" />
    <Compile Include="Perceus.fs" />
    <Compile Include="RCInterpreter.fs" />
    <Compile Include="SourceInterpreter.fs" />
    <Compile Include="IExprPrint.fs" />
    <Compile Include="Examples.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
