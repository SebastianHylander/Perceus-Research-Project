%{
open Lang
%}

%token <string> NAME

%token LET IN FUN MATCH END
%token LPAR RPAR LBRACE RBRACE
%token COMMA SEMICOLON RIGHTARROW EQ
%token EOF

%nonassoc NAME
%nonassoc LPAR

%start Main
%type <Expr> Main

%%

Main:
    Expr EOF                            { $1 }
;

Expr:
    AppExpr                             { $1 }
  | LetExpr                             { $1 }
  | FunExpr                             { $1 }
  | MatchExpr                           { $1 }
;

AppExpr:
    Atom                                { $1 }
  | AppExpr Atom                        { App($1, $2) }
;

Atom:
    NAME                                { Var $1 }
  | NAME LPAR RPAR                      { Con($1, []) }
  | NAME LPAR ArgList RPAR              { Con($1, $3) }
  | LPAR Expr RPAR                      { $2 }
;

ArgList:
    Expr                                { [$1] }
  | Expr COMMA ArgList                  { $1 :: $3 }
;

LetExpr:
    LET NAME EQ Expr IN Expr END        { Let($2, $4, $6) }
;

FunExpr:
    FUN NAME RIGHTARROW Expr            { Lam($2, $4) }
;

MatchExpr:
    MATCH LPAR Expr RPAR LBRACE RBRACE  { Match($3, []) }
  | MATCH LPAR Expr RPAR LBRACE Branches RBRACE
                                        { Match($3, $6) }
;

Branches:
    Branch                              { [$1] }
  | Branch Branches                     { $1 :: $2 }
;

Branch:
    Pattern RIGHTARROW BranchBody       { ($1, $3) }
  | Pattern BranchBody                  { ($1, $2) }
;

Pattern:
    NAME                                { ($1, []) }
  | NAME LPAR RPAR                      { ($1, []) }
  | NAME LPAR PatternArgs RPAR          { ($1, $3) }
;

PatternArgs:
    NAME                                { [$1] }
  | NAME COMMA PatternArgs              { $1 :: $3 }
;

BranchBody:
    Block                               { $1 }
  | LetExpr                             { $1 }
  | MatchExpr                           { $1 }
  | Atom                                { $1 }
;

Block:
    LBRACE Expr RBRACE                  { $2 }
  | LBRACE Expr SEMICOLON RBRACE        { $2 }
;
